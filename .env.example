# Variables de entorno — Copiar este archivo como .env.local y completar los valores

# Base de datos (Render PostgreSQL) — se configura en Etapa 2
DATABASE_URL="postgresql://usuario:password@host:5432/agropilot"

# NextAuth — se configura en Etapa de autenticación
NEXTAUTH_SECRET="cambiar-por-un-secreto-seguro"
NEXTAUTH_URL="http://localhost:3000"
